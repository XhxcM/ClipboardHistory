<Window x:Class="ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="剪贴历史"
        Icon="Assets/ClipboardHistory.ico"
        Width="640" Height="700" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource MonolythBackgroundBrush}"
        Foreground="{DynamicResource MonolythPrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Storyboard x:Key="AmbientSignalStoryboard" Duration="0:0:16" RepeatBehavior="Forever"
                    Timeline.DesiredFrameRate="12">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CircuitField"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:16">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.66" />
                <LinearDoubleKeyFrame KeyTime="0:0:8" Value="0.92" />
                <LinearDoubleKeyFrame KeyTime="0:0:16" Value="0.66" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalOneTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="-74" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="-142" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-260" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalOneTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="18" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="18" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-12" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalOne" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:14.5" Value="0.70" /><SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalTwoTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="-62" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="-128" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-210" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalTwoTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="28" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="28" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalTwo" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.96" /><LinearDoubleKeyFrame KeyTime="0:0:14.2" Value="0.64" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalThreeTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="-35" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="-75" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-295" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalThreeTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="80" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="130" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="130" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalThree" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:2.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3.6" Value="0.92" /><LinearDoubleKeyFrame KeyTime="0:0:14.4" Value="0.68" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFourTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="-20" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="-55" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-300" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFourTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="78" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="128" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="198" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFour" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:3.8" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4.6" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:14.6" Value="0.72" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFiveTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="74" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="142" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="260" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFiveTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="18" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="18" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="-12" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalFive" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.98" /><LinearDoubleKeyFrame KeyTime="0:0:14.3" Value="0.66" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSixTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="62" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="128" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="220" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSixTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="28" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="28" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSix" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:14.5" Value="0.70" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSevenTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="35" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="75" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="290" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSevenTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="80" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="130" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="130" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalSeven" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4" Value="0.94" /><LinearDoubleKeyFrame KeyTime="0:0:14.4" Value="0.68" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalEightTransform" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="-2" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="-5" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalEightTransform" Storyboard.TargetProperty="Y">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" /><LinearDoubleKeyFrame KeyTime="0:0:5" Value="120" />
                <LinearDoubleKeyFrame KeyTime="0:0:10" Value="260" /><LinearDoubleKeyFrame KeyTime="0:0:16" Value="370" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalEight" Storyboard.TargetProperty="Opacity" Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="1" /><LinearDoubleKeyFrame KeyTime="0:0:14.7" Value="0.74" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Style x:Key="CircuitPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource MonolythCircuitBrush}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
        <Style x:Key="SignalNodeStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#F0FFFF" Offset="0" />
                                        <GradientStop Color="#B845CDBB" Offset="0.24" />
                                        <GradientStop Color="#4045CDBB" Offset="0.56" />
                                        <GradientStop Color="#0045CDBB" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource MonolythAccentBrush}" Opacity="0.62" />
                            <Ellipse Width="4" Height="4" Fill="#F0FFFF" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{DynamicResource MonolythBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.34">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.36" GradientOrigin="0.5,0.36" RadiusX="0.62" RadiusY="0.48">
                    <GradientStop Color="#365FD8CA" Offset="0" />
                    <GradientStop Color="#0C45CDBB" Offset="0.42" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="AmbientField" Grid.RowSpan="2">
        <Viewbox x:Name="CircuitField" Grid.RowSpan="2" Stretch="Fill"
                 IsHitTestVisible="False" Opacity="0.92">
            <Canvas Width="640" Height="700" CacheMode="BitmapCache">
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 260,340 L 190,365 L 120,365 L 0,330" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 286,350 L 250,380 L 196,410 L 0,410" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 300,365 L 270,415 L 220,460 L 0,460" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 310,380 L 285,460 L 245,510 L 0,510" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 315,410 L 300,510 L 270,580 L 0,580" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 318,440 L 315,560 L 310,700" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 380,340 L 450,365 L 520,365 L 640,330" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 354,350 L 390,380 L 444,410 L 640,410" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 340,365 L 370,415 L 420,460 L 640,460" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 330,380 L 355,460 L 395,510 L 640,510" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 325,410 L 340,510 L 370,580 L 640,580" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 322,440 L 325,560 L 330,700" />
                <Path Style="{StaticResource CircuitPathStyle}" Data="M 320,318 L 320,700" />
                <Ellipse Canvas.Left="260" Canvas.Top="258" Width="120" Height="120" Opacity="0.52">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#705FD8CA" Offset="0" />
                            <GradientStop Color="#245FD8CA" Offset="0.42" />
                            <GradientStop Color="#005FD8CA" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="301" Canvas.Top="299" Width="38" Height="38"
                         Fill="{DynamicResource MonolythAccentBrush}" Opacity="0.18" />
                <Ellipse Canvas.Left="316" Canvas.Top="314" Width="8" Height="8" Fill="#F0FFFF" />
            </Canvas>
        </Viewbox>
        <Viewbox Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False">
            <Canvas x:Name="SignalLayer" Width="640" Height="700" CacheMode="BitmapCache">
                <ContentControl x:Name="SignalOne" Canvas.Left="260" Canvas.Top="331"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalOneTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalTwo" Canvas.Left="210" Canvas.Top="401"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalTwoTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalThree" Canvas.Left="286" Canvas.Top="371"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalThreeTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalFour" Canvas.Left="291" Canvas.Top="501"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalFourTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalFive" Canvas.Left="362" Canvas.Top="331"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalFiveTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalSix" Canvas.Left="412" Canvas.Top="401"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalSixTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalSeven" Canvas.Left="336" Canvas.Top="371"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalSevenTransform" /></ContentControl.RenderTransform>
                </ContentControl>
                <ContentControl x:Name="SignalEight" Canvas.Left="311" Canvas.Top="401"
                                Style="{StaticResource SignalNodeStyle}">
                    <ContentControl.RenderTransform><TranslateTransform x:Name="SignalEightTransform" /></ContentControl.RenderTransform>
                </ContentControl>
            </Canvas>
        </Viewbox>
        </Grid>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/ClipboardHistory.ico" Width="18" Height="18" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="剪贴历史" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Margin="12,0" Background="{DynamicResource MonolythBorderBrush}" />
                <Border x:Name="StatusSurface" Padding="6,3" CornerRadius="6"
                        Background="{DynamicResource MonolythSurfaceBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Width="6" Height="6" Margin="0,0,7,0"
                                 Fill="{DynamicResource MonolythAccentBrush}" />
                        <TextBlock x:Name="StatusText" Text="正在记录文本剪贴板" FontSize="12"
                                   Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Content="设置" Click="OpenSettings_Click"
                    Margin="6,6" MinHeight="32" Padding="12,4"
                    Style="{StaticResource ActionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    automation:AutomationProperties.Name="打开设置" />
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="—" Click="MinimizeWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="最小化窗口" />
                <Button x:Name="MaximizeButton" Content="□" Click="ToggleMaximizeWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="最大化窗口" />
                <Button x:Name="CloseButton" Content="×" Click="CloseWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="关闭到系统托盘" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SearchPanel" Margin="24,20,24,12">
                <TextBox x:Name="SearchBox" Height="46"
                         TextChanged="SearchBox_TextChanged"
                         Style="{StaticResource TextFieldStyle}"
                         ToolTip="搜索历史（Ctrl+F）"
                         automation:AutomationProperties.Name="搜索剪贴板历史" />
                <TextBlock Text="搜索历史 · Ctrl+F" Margin="15,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource MonolythSecondaryTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid x:Name="HistoryPanel" Grid.Row="1" Margin="24,0"
                  Background="Transparent">
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="▣" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MonolythAccentBrush}" Opacity="0.72" />
                    <TextBlock x:Name="EmptyStateTitle" Text="等待第一条记录"
                               Margin="0,14,0,5" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateText" Text="复制一段文本，它会出现在这里"
                               Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListBox x:Name="HistoryList"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         automation:AutomationProperties.Name="剪贴板历史列表">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent">
                                            <Border x:Name="RowSurface"
                                                    Margin="8,4" Padding="16,12,14,12"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource MonolythSurfaceBrush}"
                                                    BorderBrush="{DynamicResource MonolythBorderBrush}"
                                                    BorderThickness="1"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" />
                                                        <TranslateTransform x:Name="RowLift" Y="0" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Border x:Name="SelectionAccent" Width="2" Height="32"
                                                            Margin="-8,0,0,0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{DynamicResource MonolythAccentBrush}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background"
                                                        Value="{DynamicResource MonolythHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background"
                                                        Value="{DynamicResource MonolythAccentSoftBrush}" />
                                                <Setter TargetName="RowSurface" Property="BorderBrush"
                                                        Value="{DynamicResource MonolythAccentBrush}" />
                                                <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="RowSurface" Property="BorderBrush"
                                                        Value="{DynamicResource MonolythAccentBrush}" />
                                            </Trigger>
                                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1.01" Duration="0:0:0.16" EasingFunction="{StaticResource MotionEase}" />
                                                        <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1.01" Duration="0:0:0.16" EasingFunction="{StaticResource MotionEase}" />
                                                        <DoubleAnimation Storyboard.TargetName="RowLift" Storyboard.TargetProperty="Y"
                                                                         To="-1" Duration="0:0:0.16" EasingFunction="{StaticResource MotionEase}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX"
                                                                         To="1" Duration="0:0:0.18" EasingFunction="{StaticResource MotionEase}" />
                                                        <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY"
                                                                         To="1" Duration="0:0:0.18" EasingFunction="{StaticResource MotionEase}" />
                                                        <DoubleAnimation Storyboard.TargetName="RowLift" Storyboard.TargetProperty="Y"
                                                                         To="0" Duration="0:0:0.18" EasingFunction="{StaticResource MotionEase}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource MonolythContextMenuStyle}">
                            <MenuItem Header="复制" Click="CopyMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                            <MenuItem Header="删除" Click="DeleteMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                            <Separator />
                            <MenuItem Header="不再记录此应用" Click="ExcludeSourceMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="42" FontSize="14" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SourceApp}" FontSize="12"
                                               Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontSize="12" Margin="12,0,0,0"
                                               Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="HistoryFooter" Grid.Row="2" Margin="24,12,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PausedIndicator" Width="6" Height="6" Margin="0,0,8,0"
                             Fill="{DynamicResource MonolythDangerBrush}" Visibility="Collapsed" />
                    <Button x:Name="PauseButton" Content="暂停记录" Click="PauseButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="暂停或恢复记录" />
                </StackPanel>
                <Button x:Name="ClearButton" Grid.Column="2" Content="清空全部" Click="ClearButton_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        automation:AutomationProperties.Name="清空全部历史记录" />
            </Grid>

            <Grid x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                  Margin="40,20,40,20" Opacity="1"
                  Background="Transparent">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Button Content="返回" Click="BackToHistory_Click" DockPanel.Dock="Left"
                            Style="{StaticResource ActionButtonStyle}" />
                    <TextBlock Text="剪贴历史  /  设置" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,8,8">
                        <TextBlock x:Name="StartupSectionTitle" Text="启动与快捷键"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="控制程序何时启动，以及从任何位置呼出窗口。" Margin="0,5,0,16"
                                   Foreground="{DynamicResource MonolythSecondaryTextBrush}" />

                        <Grid MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="登录后自动启动" FontWeight="SemiBold" />
                                <TextBlock Text="在系统托盘中保持可用" Margin="0,3,12,0" FontSize="12"
                                           Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1"
                                      VerticalAlignment="Center" Style="{StaticResource ToggleStyle}"
                                      automation:AutomationProperties.Name="登录 Windows 后自动启动" />
                        </Grid>

                        <Border Height="1" Margin="0,14" Background="{DynamicResource MonolythBorderBrush}" />
                        <TextBlock Text="呼出快捷键" FontWeight="SemiBold" />
                        <TextBox x:Name="HotKeyTextBox" IsReadOnly="True" Margin="0,8,0,5"
                                 Style="{StaticResource TextFieldStyle}"
                                 PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"
                                 automation:AutomationProperties.Name="设置呼出快捷键" />
                        <TextBlock Text="点击输入框，再按下带 Ctrl、Alt、Shift 或 Win 的组合键。"
                                   FontSize="12" Foreground="{DynamicResource MonolythSecondaryTextBrush}" />

                        <Border Height="1" Margin="0,20" Background="{DynamicResource MonolythBorderBrush}" />
                        <TextBlock x:Name="ExcludedAppsSectionTitle" Text="排除应用"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="只保存可执行文件名，不保存窗口标题。" Margin="0,5,0,12"
                                   Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                        <Border CornerRadius="10" Background="{DynamicResource MonolythSurfaceBrush}"
                                BorderBrush="{DynamicResource MonolythBorderBrush}" BorderThickness="1">
                            <Grid MinHeight="84" MaxHeight="156">
                                <TextBlock x:Name="ExcludedAppsEmptyState" Text="未排除任何应用"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                                <ListBox x:Name="ExcludedAppsListBox" MinHeight="84" MaxHeight="156"
                                         SelectionChanged="ExcludedAppsListBox_SelectionChanged"
                                         Background="Transparent" BorderThickness="0" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcludedAppTextBox" Style="{StaticResource TextFieldStyle}"
                                     automation:AutomationProperties.Name="要排除的应用程序名" />
                            <Button Grid.Column="1" Content="添加" Click="AddExcludedApp_Click" Margin="8,0,0,0"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <Button x:Name="RemoveExcludedAppButton" Grid.Column="2" Content="移除选中"
                                    Click="RemoveExcludedApp_Click" Margin="8,0,0,0" Visibility="Collapsed"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="SaveSettingsButton" Content="保存设置" Click="SaveSettings_Click"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Panel.ZIndex="100"
              Visibility="Collapsed" Background="{DynamicResource MonolythOverlayBrush}"
              FocusManager.IsFocusScope="True"
              FocusManager.FocusedElement="{Binding ElementName=DialogCancelButton}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Cycle"
              MouseLeftButtonDown="DialogOverlay_MouseLeftButtonDown">
            <Border Width="420" MaxWidth="520" Margin="24" Padding="24" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource MonolythSurfaceBrush}"
                    BorderBrush="{DynamicResource MonolythBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="DialogTitleText" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DialogMessageText" Margin="0,10,0,22" TextWrapping="Wrap"
                               Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelButton" Content="取消"
                                Click="DialogCancelButton_Click" Margin="0,0,8,0"
                                Style="{StaticResource ActionButtonStyle}"
                                automation:AutomationProperties.Name="取消并关闭对话框" />
                        <Button x:Name="DialogPrimaryButton" Content="确认"
                                Click="DialogPrimaryButton_Click"
                                Style="{StaticResource ActionButtonStyle}"
                                automation:AutomationProperties.Name="确认对话框操作" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
