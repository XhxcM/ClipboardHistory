<Window x:Class="ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="剪贴历史"
        Icon="Assets/ClipboardHistory.ico"
        Width="640" Height="700" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource MonolythBackgroundBrush}"
        Foreground="{DynamicResource MonolythPrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Storyboard x:Key="AmbientSignalStoryboard" Duration="0:0:16" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SignalOneTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="150" Duration="0:0:16" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalOne"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:16">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:4" Value="0.72" />
                <SplineDoubleKeyFrame KeyTime="0:0:12" Value="0.52" />
                <SplineDoubleKeyFrame KeyTime="0:0:16" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SignalTwoTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="-148" Duration="0:0:16" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalTwo"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:3" Duration="0:0:13">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:3" Value="0.62" />
                <SplineDoubleKeyFrame KeyTime="0:0:10" Value="0.42" />
                <SplineDoubleKeyFrame KeyTime="0:0:13" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SignalThreeTransform"
                             Storyboard.TargetProperty="X"
                             From="0" To="82" Duration="0:0:16" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SignalThree"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:7" Duration="0:0:9">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.68" />
                <SplineDoubleKeyFrame KeyTime="0:0:7" Value="0.46" />
                <SplineDoubleKeyFrame KeyTime="0:0:9" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootSurface" Background="{DynamicResource MonolythBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox x:Name="CircuitField" Grid.RowSpan="2" Height="184" VerticalAlignment="Top"
                 Stretch="Fill" IsHitTestVisible="False" Opacity="0.92">
            <Canvas Width="640" Height="184" CacheMode="BitmapCache">
                <Path Stroke="{DynamicResource MonolythCircuitBrush}" StrokeThickness="1"
                      Data="M 0,26 L 196,26 L 304,112 L 640,112" />
                <Path Stroke="{DynamicResource MonolythCircuitBrush}" StrokeThickness="1"
                      Data="M 0,72 L 150,72 L 286,126 L 640,126" />
                <Path Stroke="{DynamicResource MonolythCircuitBrush}" StrokeThickness="1"
                      Data="M 640,34 L 468,34 L 340,112 L 0,112" />
                <Path Stroke="{DynamicResource MonolythCircuitBrush}" StrokeThickness="1"
                      Data="M 640,82 L 504,82 L 356,126 L 0,126" />
                <Path Stroke="{DynamicResource MonolythCircuitBrush}" StrokeThickness="1"
                      Data="M 128,0 L 286,126 M 512,0 L 356,126" />
                <Ellipse Canvas.Left="282" Canvas.Top="122" Width="7" Height="7"
                         Fill="{DynamicResource MonolythAccentBrush}" Opacity="0.48" />
                <Ellipse Canvas.Left="351" Canvas.Top="122" Width="7" Height="7"
                         Fill="{DynamicResource MonolythAccentBrush}" Opacity="0.34" />
            </Canvas>
        </Viewbox>
        <Canvas x:Name="SignalLayer" Grid.RowSpan="2" Height="184" VerticalAlignment="Top"
                IsHitTestVisible="False" CacheMode="BitmapCache">
            <Ellipse x:Name="SignalOne" Canvas.Left="148" Canvas.Top="69" Width="5" Height="5"
                     Fill="{DynamicResource MonolythAccentBrush}" Opacity="0">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SignalOneTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="SignalTwo" Canvas.Left="486" Canvas.Top="79" Width="4" Height="4"
                     Fill="{DynamicResource MonolythAccentBrush}" Opacity="0">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SignalTwoTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="SignalThree" Canvas.Left="278" Canvas.Top="122" Width="6" Height="6"
                     Fill="{DynamicResource MonolythAccentBrush}" Opacity="0">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SignalThreeTransform" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/ClipboardHistory.ico" Width="18" Height="18" Margin="0,0,10,0" />
                <TextBlock Text="剪贴历史" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Margin="12,0" Background="{DynamicResource MonolythBorderBrush}" />
                <Ellipse x:Name="StatusIndicator" Width="6" Height="6" Margin="0,0,7,0"
                         Fill="{DynamicResource MonolythAccentBrush}" />
                <TextBlock x:Name="StatusText" Text="正在记录文本剪贴板" FontSize="12"
                           Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="设置" Click="OpenSettings_Click"
                    Margin="6,6" MinHeight="32" Padding="12,4"
                    Style="{StaticResource ActionButtonStyle}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    automation:AutomationProperties.Name="打开设置" />
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Content="—" Click="MinimizeWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="最小化窗口" />
                <Button x:Name="MaximizeButton" Content="□" Click="ToggleMaximizeWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="最大化窗口" />
                <Button x:Name="CloseButton" Content="×" Click="CloseWindow_Click"
                        Style="{StaticResource CaptionButtonStyle}"
                        automation:AutomationProperties.Name="关闭到系统托盘" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SearchPanel" Margin="24,20,24,12">
                <TextBox x:Name="SearchBox" Height="46"
                         TextChanged="SearchBox_TextChanged"
                         Style="{StaticResource TextFieldStyle}"
                         ToolTip="搜索历史（Ctrl+F）"
                         automation:AutomationProperties.Name="搜索剪贴板历史" />
            </Grid>

            <Grid x:Name="HistoryPanel" Grid.Row="1" Margin="24,0">
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="▣" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource MonolythAccentBrush}" Opacity="0.72" />
                    <TextBlock x:Name="EmptyStateTitle" Text="等待第一条记录"
                               Margin="0,14,0,5" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateText" Text="复制一段文本，它会出现在这里"
                               Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListBox x:Name="HistoryList"
                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         automation:AutomationProperties.Name="剪贴板历史列表">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent">
                                            <Border x:Name="RowSurface"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource MonolythBorderBrush}"
                                                    BorderThickness="0,0,0,1" />
                                            <Border x:Name="SelectionAccent" Width="2" Height="32"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource MonolythAccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter Margin="16,12,14,12"
                                                              HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background"
                                                        Value="{DynamicResource MonolythHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowSurface" Property="Background"
                                                        Value="{DynamicResource MonolythAccentSoftBrush}" />
                                                <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="RowSurface" Property="BorderBrush"
                                                        Value="{DynamicResource MonolythAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource MonolythContextMenuStyle}">
                            <MenuItem Header="复制" Click="CopyMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                            <MenuItem Header="删除" Click="DeleteMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                            <Separator />
                            <MenuItem Header="不再记录此应用" Click="ExcludeSourceMenuItem_Click"
                                      Style="{StaticResource MonolythMenuItemStyle}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="42" FontSize="14" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SourceApp}" FontSize="12"
                                               Foreground="{DynamicResource MonolythSecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontSize="12" Margin="12,0,0,0"
                                               Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="HistoryFooter" Grid.Row="2" Margin="24,12,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="PausedIndicator" Width="6" Height="6" Margin="0,0,8,0"
                             Fill="{DynamicResource MonolythDangerBrush}" Visibility="Collapsed" />
                    <Button x:Name="PauseButton" Content="暂停记录" Click="PauseButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="暂停或恢复记录" />
                </StackPanel>
                <Button x:Name="ClearButton" Grid.Column="2" Content="清空全部" Click="ClearButton_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        automation:AutomationProperties.Name="清空全部历史记录" />
            </Grid>

            <Grid x:Name="SettingsPanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                  Margin="24,20,24,20" Background="{DynamicResource MonolythBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <Button Content="返回" Click="BackToHistory_Click" DockPanel.Dock="Left"
                            Style="{StaticResource ActionButtonStyle}" />
                    <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,2">
                        <Border x:Name="StartupSettingsCard" Padding="16" CornerRadius="10"
                                Background="{DynamicResource MonolythSurfaceBrush}"
                                BorderBrush="{DynamicResource MonolythBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="启动与快捷键" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="登录 Windows 后自动启动"
                                          Margin="0,0,0,18" Style="{StaticResource ToggleStyle}" />
                                <TextBlock Text="呼出快捷键" FontWeight="SemiBold" />
                                <TextBox x:Name="HotKeyTextBox" IsReadOnly="True" Margin="0,7,0,5"
                                         Style="{StaticResource TextFieldStyle}"
                                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"
                                         automation:AutomationProperties.Name="设置呼出快捷键" />
                                <TextBlock Text="点击输入框，再按下带 Ctrl、Alt、Shift 或 Win 的组合键。"
                                           Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ExcludedAppsCard" Margin="0,12,0,0" Padding="16" CornerRadius="10"
                                Background="{DynamicResource MonolythSurfaceBrush}"
                                BorderBrush="{DynamicResource MonolythBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="排除应用" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="只保存可执行文件名，不保存窗口标题。" Margin="0,4,0,10"
                                           Foreground="{DynamicResource MonolythSecondaryTextBrush}" />
                                <Border CornerRadius="10" Background="{DynamicResource MonolythBackgroundBrush}"
                                        BorderBrush="{DynamicResource MonolythBorderBrush}" BorderThickness="1" Padding="4">
                                    <ListBox x:Name="ExcludedAppsListBox" MinHeight="100" MaxHeight="180"
                                             Background="Transparent" BorderThickness="0" />
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExcludedAppTextBox" Style="{StaticResource TextFieldStyle}"
                                             automation:AutomationProperties.Name="要排除的应用程序名" />
                                    <Button Grid.Column="1" Content="添加" Click="AddExcludedApp_Click" Margin="8,0,0,0"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Grid.Column="2" Content="移除选中" Click="RemoveExcludedApp_Click" Margin="8,0,0,0"
                                            Style="{StaticResource ActionButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="保存设置" Click="SaveSettings_Click"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
